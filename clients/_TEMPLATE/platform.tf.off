# ─────────────────────────────────────────────────────────────────────
# OPTIONAL: Jamf Platform features — macOS software update Blueprints,
# passcode policy Blueprint, CIS Level 1 benchmark (report-only).
#
# This file is OFF (Terraform ignores .off files). To enable:
#
#   1. Rename:  platform.tf.off  ->  platform.tf
#   2. In terraform.tfvars, fill ALL of: jamfplatform_client_id,
#      jamfplatform_client_secret, jamfplatform_tenant_id (the tenant
#      UUID from the Integrations space at account.jamf.com). All three
#      are REQUIRED — the provider authenticates the moment you run
#      `terraform plan`, before creating anything.
#   3. Set the enable_* toggles in terraform.tfvars as desired.
#
# Why a separate file (VERIFIED live 2026-08-01): the jamfplatform
# provider authenticates during plan even when every Platform feature is
# disabled. Keeping the provider + module out of the config entirely is
# the only reliable off-switch for clients without Platform API access.
# ─────────────────────────────────────────────────────────────────────

provider "jamfplatform" {
  base_url      = var.jamfplatform_base_url
  client_id     = var.jamfplatform_client_id
  client_secret = var.jamfplatform_client_secret
  tenant_id     = var.jamfplatform_tenant_id
}

module "platform" {
  source = "../../modules/client-platform"

  enable_software_update_blueprints = var.enable_software_update_blueprints
  software_update_minor_days        = var.software_update_minor_days
  software_update_major_days        = var.software_update_major_days
  software_update_install_time      = var.software_update_install_time
  software_update_device_group_name = var.software_update_device_group_name

  enable_passcode_blueprint = var.enable_passcode_blueprint
  passcode_min_length       = var.passcode_min_length
  enable_cis_benchmark      = var.enable_cis_benchmark
}

output "platform_summary" {
  value = module.platform.summary
}
