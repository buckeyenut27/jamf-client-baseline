<plist version="1.0">
<dict>
	<key>PayloadContent</key>
	<array>
		<dict>
			<key>PayloadDisplayName</key>
			<string>Screen Saver Lock</string>
			<key>PayloadIdentifier</key>
			<string>com.apple.screensaver.msp-lock</string>
			<key>PayloadType</key>
			<string>com.apple.screensaver</string>
			<key>PayloadUUID</key>
			<string>9C3D4E50-0000-4000-8000-0000000000C1</string>
			<key>PayloadVersion</key>
			<integer>1</integer>
			<key>askForPassword</key>
			<true/>
			<key>askForPasswordDelay</key>
			<integer>0</integer>
			<key>idleTime</key>
			<integer>${idle_seconds}</integer>
		</dict>
	</array>
	<key>PayloadDescription</key>
	<string>Screen saver idle timeout with immediate password requirement</string>
